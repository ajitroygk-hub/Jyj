<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_mesh">

    <!-- Red Screen Overlay Effect (animates 0 -> 0.08 on active) -->
    <View
        android:id="@+id/redOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/accent_red"
        android:alpha="0.0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar with status info -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="42dp"
            android:paddingBottom="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- System Telemetry: Battery & RAM -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/batteryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BAT --%"
                    android:textColor="@color/accent_red"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ramText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAM --GB"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Brand Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/appTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MYRA"
                    android:textColor="@color/accent_red"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.25"
                    android:shadowColor="#80FF1744"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI COMPANION"
                    android:textColor="@color/text_hint"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15" />
            </LinearLayout>

            <!-- Time & Settings button -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="end|center_vertical">

                <TextView
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:00"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <ImageButton
                    android:id="@+id/settingsBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="Settings"
                    android:padding="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Center Stage: Orb, Waveform & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="16dp">

            <com.myra.assistant.ui.main.OrbAnimationView
                android:id="@+id/orbAnimationView"
                android:layout_width="260dp"
                android:layout_height="260dp" />

            <com.myra.assistant.ui.main.WaveformView
                android:id="@+id/waveformView"
                android:layout_width="220dp"
                android:layout_height="40dp"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap karke bolo 💬"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Bottom Area: Chat RecyclerView and Control Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatRecycler"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:scrollbars="none" />

            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_mic_button"
                android:src="@drawable/ic_mic_off"
                android:contentDescription="Toggle Mic"
                android:scaleType="centerInside"
                android:elevation="6dp" />

            <TextView
                android:id="@+id/hintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Long press mic to stop MYRA"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
